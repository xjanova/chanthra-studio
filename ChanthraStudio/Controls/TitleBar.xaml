<UserControl
    x:Class="ChanthraStudio.Controls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ChanthraStudio.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:ChanthraStudio.ViewModels"
    Height="38"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    d:DesignWidth="1640"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="138" />
        </Grid.ColumnDefinitions>

        <!--  Brand cell  -->
        <StackPanel
            Grid.Column="0"
            Margin="14,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <c:BrandMark VerticalAlignment="Center" />
            <TextBlock
                Margin="9,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource TextWordmarkBrand}">
                <Run Text="Chanthra " />
                <Run
                    FontStyle="Italic"
                    Foreground="{StaticResource BrushGoldHi}"
                    Text="Studio" />
            </TextBlock>
        </StackPanel>

        <!--  search  -->
        <StackPanel
            Grid.Column="2"
            Margin="6,0,12,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border
                Width="320"
                Height="26"
                Margin="0,0,0,0"
                Background="{StaticResource BrushSurface03}"
                BorderBrush="{StaticResource BrushLineHairline}"
                BorderThickness="1"
                CornerRadius="13">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Grid.Column="0"
                        Width="13"
                        Height="13"
                        Data="{StaticResource IcoSearch}"
                        Stretch="Uniform"
                        Stroke="{StaticResource BrushText3}"
                        StrokeThickness="1.5" />
                    <TextBox
                        Grid.Column="1"
                        Padding="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SearchTextBox}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        Tag="Filter library + storyboard…" />
                    <Border
                        Grid.Column="2"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource BrushBgInset}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Style="{StaticResource TextMonoUpper}"
                            Text="Ctrl K" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!--  Window controls  -->
        <StackPanel
            Grid.Column="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button
                x:Name="MinBtn"
                Click="MinBtn_Click"
                Style="{StaticResource ButtonWindowControl}"
                ToolTip="Minimize">
                <Path
                    Width="11"
                    Height="11"
                    Data="{StaticResource IcoMinimize}"
                    Stretch="Uniform"
                    Stroke="{StaticResource BrushText2}"
                    StrokeThickness="1.4" />
            </Button>
            <Button
                x:Name="MaxBtn"
                Click="MaxBtn_Click"
                Style="{StaticResource ButtonWindowControl}"
                ToolTip="Maximize">
                <Path
                    Width="11"
                    Height="11"
                    Data="{StaticResource IcoMaximize}"
                    Fill="Transparent"
                    Stretch="Uniform"
                    Stroke="{StaticResource BrushText2}"
                    StrokeThickness="1.4" />
            </Button>
            <Button
                x:Name="CloseBtn"
                Click="CloseBtn_Click"
                Style="{StaticResource ButtonWindowClose}"
                ToolTip="Close">
                <Path
                    Width="11"
                    Height="11"
                    Data="{StaticResource IcoClose}"
                    Stretch="Uniform"
                    Stroke="{StaticResource BrushText2}"
                    StrokeThickness="1.4" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
