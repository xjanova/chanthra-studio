<UserControl
    x:Class="ChanthraStudio.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ChanthraStudio.ViewModels"
    Background="{StaticResource BrushBgBase}"
    d:DataContext="{d:DesignInstance vm:EditorViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1500"
    mc:Ignorable="d"
    PreviewKeyDown="Editor_PreviewKeyDown"
    Focusable="True">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource ThinScrollBar}" TargetType="ScrollBar" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadProjectCommand}" />
        <!--  NLE-style hotkeys. Mirrors Premiere/Resolve where possible.  -->
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedSlotCommand}" />
        <KeyBinding Key="Back" Command="{Binding DeleteSelectedSlotCommand}" />
        <KeyBinding Key="Left" Command="{Binding NavSelectedLeftCommand}" />
        <KeyBinding Key="Right" Command="{Binding NavSelectedRightCommand}" />
        <KeyBinding Key="J" Command="{Binding NudgePlayheadBackCommand}" />
        <KeyBinding Key="L" Command="{Binding NudgePlayheadForwardCommand}" />
        <KeyBinding Key="C" Command="{Binding RazorAtPlayheadCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Autosave recovery banner — shown on first paint if a previous
              session left an .autosave.chstudio file behind. User clicks
              Recover to restore that state OR Dismiss to delete it.  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="0,62,0,0"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="60"
            Background="#1FE0B056"
            BorderBrush="#66E0B056"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource ShadowGoldGlowSoft}"
            Visibility="{Binding HasAutosaveRecovery, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontDisplay}" FontStyle="Italic" FontSize="14" Foreground="{StaticResource BrushText1}" Text="✦ Autosave found from a previous session" />
                <Button Margin="14,0,6,0" Padding="12,4" Command="{Binding RecoverAutosaveCommand}" Content="Recover" Style="{StaticResource ButtonPillGold}" />
                <Button Padding="12,4" Command="{Binding DismissAutosaveCommand}" Content="Dismiss" Style="{StaticResource ButtonPill}" />
            </StackPanel>
        </Border>

        <!--  Toast  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="0,18,0,0"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="50"
            CornerRadius="99"
            Effect="{StaticResource ShadowGoldGlowSoft}"
            Visibility="{Binding ToastMessage, Converter={StaticResource NotNullOrEmpty}, FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrushSurface03}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="ok">
                            <Setter Property="Background" Value="#1F6DBF8C" />
                            <Setter Property="BorderBrush" Value="#666DBF8C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="warn">
                            <Setter Property="Background" Value="#1FE0B056" />
                            <Setter Property="BorderBrush" Value="#66E0B056" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="err">
                            <Setter Property="Background" Value="#1FD05A5A" />
                            <Setter Property="BorderBrush" Value="#66D05A5A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11.5" Foreground="{StaticResource BrushText1}" Text="{Binding ToastMessage}" />
        </Border>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="32,18"
            Background="{StaticResource BrushSurface02}"
            BorderBrush="{StaticResource BrushLineHairline}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource TextPanelHeader}" FontSize="22">
                        <Run Foreground="{StaticResource BrushGold}" Text="✦ " />
                        <Run Text="Editor · NLE-lite" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TextSecondary}" FontSize="12"
                               Text="Drop library clips onto the timeline, set per-slot durations, optionally pin an audio take, render." />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText3}">
                        <Run Text="TOTAL " />
                        <Run Foreground="{StaticResource BrushGoldHi}" Text="{Binding TotalDurationLabel, Mode=OneWay}" />
                    </TextBlock>
                    <Button Margin="0,0,8,0" Padding="10,6" Command="{Binding UndoCommand}" Content="↶ Undo" Style="{StaticResource ButtonPill}" ToolTip="Undo (Ctrl+Z)" />
                    <Button Margin="0,0,14,0" Padding="10,6" Command="{Binding RedoCommand}" Content="↷ Redo" Style="{StaticResource ButtonPill}" ToolTip="Redo (Ctrl+Y)" />
                    <Button Margin="0,0,6,0" Padding="10,6" Command="{Binding LoadProjectCommand}" Content="Open…" Style="{StaticResource ButtonPill}" ToolTip="Open NLE project (Ctrl+O)" />
                    <Button Margin="0,0,6,0" Padding="8,6" Click="Recent_Click" Style="{StaticResource ButtonPill}"
                            ToolTip="Recent projects · last 5 .chstudio files you opened or saved">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding RecentProjects}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="ToolTip" Value="{Binding Path}" />
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock>Recent <Run Foreground="{StaticResource BrushText3}" Text="▾" /></TextBlock>
                    </Button>
                    <Button Margin="0,0,14,0" Padding="10,6" Command="{Binding SaveProjectCommand}" Content="Save…" Style="{StaticResource ButtonPill}" ToolTip="Save NLE project as .chstudio (Ctrl+S)" />
                    <Button Margin="0,0,8,0" Padding="14,6" Command="{Binding RefreshCommand}" Content="↻ Refresh" Style="{StaticResource ButtonPill}" />
                    <Button Padding="18,6" Command="{Binding ClearTimelineCommand}" Content="Clear timeline" Style="{StaticResource ButtonPill}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Body  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Library  -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,12,14,8" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText3}" Text="LIBRARY" />
                            <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushText4}"
                                       Text="{Binding LibraryClips.Count, StringFormat={}{0} clips available}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="10,6,10,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LibraryClips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,6"
                                        Padding="8"
                                        Background="{StaticResource BrushBgInset}"
                                        BorderBrush="{StaticResource BrushLineHairline}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        PreviewMouseLeftButtonDown="LibraryClip_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="LibraryClip_PreviewMouseMove">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="56" Height="32" CornerRadius="4" ClipToBounds="True">
                                                <Grid>
                                                    <Border Background="{StaticResource BrushSurface03}" />
                                                    <Image
                                                        Source="{Binding FilePath, Converter={StaticResource ClipPathToImage}}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11" Foreground="{StaticResource BrushText1}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource TextMonoUpper}" FontSize="9" Text="{Binding SizeLabel}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Command="{Binding DataContext.AddClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ButtonSummonCta}"
                                                ToolTip="Add to timeline">
                                                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="14" Foreground="#FF1A0D05" Text="+" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  CENTER: preview + timeline  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Preview pane — image OR live MediaElement for the selected slot's clip.  -->
                <Border Grid.Row="0" Margin="22" CornerRadius="10" ClipToBounds="True" Effect="{StaticResource ShadowCanvas}">
                    <Grid>
                        <Border Background="{StaticResource BrushBgInset}" />
                        <!--  Image layer for still clips (PNG/JPG/etc.).  -->
                        <Image
                            Source="{Binding Selected.FilePath, Converter={StaticResource ClipPathToImage}}"
                            Stretch="Uniform" />
                        <!--  MediaElement layer for video clips. Source is set imperatively in code-behind
                              so we can detect file-extension-based playability cleanly.  -->
                        <MediaElement
                            x:Name="PreviewMedia"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Stop"
                            ScrubbingEnabled="True"
                            Stretch="Uniform"
                            MediaEnded="PreviewMedia_Ended"
                            MediaOpened="PreviewMedia_Opened"
                            MediaFailed="PreviewMedia_Failed" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontDisplay}"
                            FontSize="22"
                            FontStyle="Italic"
                            Foreground="{StaticResource BrushText3}"
                            Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"
                            Text="Click a timeline slot to preview" />
                        <Border
                            Margin="14"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource BrushBlackOverlay55}"
                            CornerRadius="4"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushGoldHi}">
                                <Run Text="SLOT · " /><Run Text="{Binding Selected.FileName, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <!--  Playback transport bar — visible only when a video slot is loaded.  -->
                        <Border
                            x:Name="TransportBar"
                            Margin="14"
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource BrushBlackOverlay65}"
                            BorderBrush="{StaticResource BrushLineHairline}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="PreviewRewindBtn"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    Click="PreviewRewind_Click"
                                    Style="{StaticResource ButtonIcon}"
                                    ToolTip="Restart from 0:00">
                                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource BrushText2}" Text="⟲" />
                                </Button>
                                <Button
                                    x:Name="PreviewPlayBtn"
                                    Width="36"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    Click="PreviewPlayPause_Click"
                                    Style="{StaticResource ButtonSummonCta}"
                                    ToolTip="Play this slot with audio (space)">
                                    <TextBlock x:Name="PreviewPlayGlyph" FontFamily="{StaticResource FontMono}" FontSize="14" Foreground="#FF1A0D05" Text="▶" />
                                </Button>
                                <Button
                                    x:Name="PreviewMuteBtn"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Click="PreviewMute_Click"
                                    Style="{StaticResource ButtonIcon}"
                                    ToolTip="Mute / unmute">
                                    <TextBlock x:Name="PreviewMuteGlyph" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="{StaticResource BrushText2}" Text="🔊" />
                                </Button>
                                <TextBlock
                                    x:Name="PreviewTimecode"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TextMonoGold}"
                                    FontSize="10.5"
                                    Text="0:00" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  Timeline strip  -->
                <Border
                    Grid.Row="1"
                    MinHeight="160"
                    Background="{StaticResource BrushBlackOverlay35}"
                    BorderBrush="{StaticResource BrushLineHairline}"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="22,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TextSectionDivider}" Text="TIMELINE · VIDEO TRACK" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText4}"
                                           Text="{Binding Timeline.Count, StringFormat={}{0} slots}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="TimelinePlayBtn"
                                            Margin="0,0,6,0" Padding="10,4"
                                            Click="TimelinePlay_Click"
                                            Style="{StaticResource ButtonPillGold}"
                                            ToolTip="Play the whole timeline · silent preview · advances slots automatically (shift-space)">
                                        <TextBlock>
                                            <Run x:Name="TimelinePlayGlyph" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#FF1A0D05" Text="▶▶" />
                                            <Run Foreground="#FF1A0D05" Text=" Timeline" />
                                        </TextBlock>
                                    </Button>
                                <Button Padding="10,4" Command="{Binding RazorAtPlayheadCommand}"
                                        Style="{StaticResource ButtonPill}"
                                        ToolTip="Razor split at the playhead position (instead of the slot midpoint)">
                                    <TextBlock>
                                        <Run Foreground="{StaticResource BrushGoldHi}" Text="✂ " />
                                        <Run Text="razor @ " /><Run FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushGoldHi}" Text="{Binding PlayheadLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                                </StackPanel>
                            </Grid>
                            <!--  Scrubber — drag to move playhead; the slot under the head becomes Selected automatically  -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="{Binding TotalDuration}" SmallChange="0.1" LargeChange="1" Style="{StaticResource GoldSlider}" Value="{Binding PlayheadSec, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding PlayheadLabel, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Background="{StaticResource BrushBgInset}"
                            BorderBrush="{StaticResource BrushLineHairline}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6">
                                <ItemsControl ItemsSource="{Binding Timeline}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!--  Drop-preview gold bar on the left edge — visible while another slot is being dragged onto this one  -->
                                                <Border
                                                    Width="3"
                                                    Margin="-2,4,0,4"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource BrushGoldHi}"
                                                    CornerRadius="2"
                                                    Effect="{StaticResource ShadowGoldGlowSoft}"
                                                    Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVis}}" />
                                            <Border
                                                Margin="4"
                                                Padding="6"
                                                Background="{StaticResource BrushSurface02}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                MinWidth="120"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Slot_PreviewMouseMove"
                                                DragEnter="Slot_DragEnter"
                                                DragLeave="Slot_DragLeave"
                                                Drop="Slot_Drop">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                                                                <Setter Property="Effect" Value="{StaticResource ShadowGoldGlowSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                                        <Grid>
                                                            <Border Background="{StaticResource BrushSurface03}" />
                                                            <Image Source="{Binding FilePath, Converter={StaticResource ClipPathToImage}}" Stretch="UniformToFill" />
                                                            <Border Margin="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource BrushBlackOverlay55}" CornerRadius="3">
                                                                <TextBlock Style="{StaticResource TextMonoGold}" FontSize="9" Text="{Binding DurationSec, StringFormat={}{0:F1}s}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushText2}" TextTrimming="CharacterEllipsis" MaxWidth="120" Text="{Binding FileName}" />
                                                    <StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <Button Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                                                Command="{Binding DataContext.MoveLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}"
                                                                ToolTip="Move left">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushText2}" Text="‹" />
                                                        </Button>
                                                        <Button Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                                                Command="{Binding DataContext.MoveRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}"
                                                                ToolTip="Move right">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushText2}" Text="›" />
                                                        </Button>
                                                        <Button Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                                                Command="{Binding DataContext.SplitSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}"
                                                                ToolTip="Razor split — halve duration + clone in place">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushGoldHi}" Text="✂" />
                                                        </Button>
                                                        <Button Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                                                Command="{Binding DataContext.DuplicateSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}"
                                                                ToolTip="Duplicate slot (keep duration)">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushText2}" Text="❏" />
                                                        </Button>
                                                        <Button Width="22" Height="22" Padding="0"
                                                                Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}"
                                                                ToolTip="Remove">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushCrimson}" Text="×" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  RIGHT: inspector  -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurface02}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1,0,0,0">
                <ScrollViewer Padding="18,16,18,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextPanelHeader}" FontSize="14">
                            <Run Foreground="{StaticResource BrushGold}" Text="✦ " />
                            <Run Text="Inspector" />
                        </TextBlock>

                        <!--  Per-slot duration  -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TextMonoUpper}" Text="SLOT DURATION" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.5" Maximum="20" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding Selected.DurationSec, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.DurationSec, StringFormat={}{0:F1}s}" />
                            </Grid>
                        </StackPanel>

                        <!--  Ken Burns (T47) — start/end zoom %, presets, reset  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TextMonoUpper}" Text="KEN BURNS · ZOOM" />
                                    <Button Grid.Column="1" Padding="6,2" Command="{Binding ResetKenBurnsCommand}" Content="reset" Style="{StaticResource ButtonPill}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource BrushText4}" Text="100 → 100 = static · 100 → 115 = push-in · 115 → 100 = pull-back" />

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMonoUpper}" Text="START · END" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="100" Maximum="200" SmallChange="1" LargeChange="5" Style="{StaticResource GoldSlider}" Value="{Binding Selected.ZoomStartPct, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.ZoomStartPct, StringFormat={}{0:F0}%}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="100" Maximum="200" SmallChange="1" LargeChange="5" Style="{StaticResource GoldSlider}" Value="{Binding Selected.ZoomEndPct, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.ZoomEndPct, StringFormat={}{0:F0}%}" />
                                </Grid>

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Margin="0,0,6,0" Padding="8,3" Command="{Binding KenBurnsPushInCommand}" Content="↗ push-in" Style="{StaticResource ButtonPill}"
                                            ToolTip="Set zoom 100 → 115% — slow camera push into the frame" />
                                    <Button Padding="8,3" Command="{Binding KenBurnsPullBackCommand}" Content="↙ pull-back" Style="{StaticResource ButtonPill}"
                                            ToolTip="Set zoom 115 → 100% — slow camera pull-back" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Color grade (T48) — eq=brightness:contrast:saturation  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TextMonoUpper}" Text="COLOR GRADE · EQ" />
                                    <Button Grid.Column="1" Padding="6,2" Command="{Binding ResetColorGradeCommand}" Content="reset" Style="{StaticResource ButtonPill}" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMonoUpper}" Text="BRIGHTNESS" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="-0.5" Maximum="0.5" SmallChange="0.01" LargeChange="0.1" Style="{StaticResource GoldSlider}" Value="{Binding Selected.Brightness, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.Brightness, StringFormat={}{0:F2}}" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMonoUpper}" Text="CONTRAST" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0.5" Maximum="2.0" SmallChange="0.05" LargeChange="0.2" Style="{StaticResource GoldSlider}" Value="{Binding Selected.Contrast, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.Contrast, StringFormat={}{0:F2}}" />
                                </Grid>

                                <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMonoUpper}" Text="SATURATION" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.25" Style="{StaticResource GoldSlider}" Value="{Binding Selected.Saturation, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding Selected.Saturation, StringFormat={}{0:F2}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextMonoUpper}" Text="OUTPUT NAME" />
                                <Border Margin="0,4,0,0" Padding="8,5" Background="{StaticResource BrushSurface03}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="4">
                                    <TextBox Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource BrushGoldHi}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushText1}" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="CROSSFADE BETWEEN SLOTS" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" Style="{StaticResource GoldSlider}" Value="{Binding CrossfadeSec, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding CrossfadeSec, StringFormat={}{0:F1}s}" />
                                </Grid>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="FRAME RATE" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <RadioButton GroupName="fps" Margin="0,0,4,0" Content="24" Style="{StaticResource ChipRadio}"
                                                 IsChecked="{Binding Fps, Converter={StaticResource StringEquals}, ConverterParameter=24, Mode=OneWay}"
                                                 Click="Fps_Click" Tag="24" />
                                    <RadioButton GroupName="fps" Margin="0,0,4,0" Content="30" Style="{StaticResource ChipRadio}"
                                                 IsChecked="{Binding Fps, Converter={StaticResource StringEquals}, ConverterParameter=30, Mode=OneWay}"
                                                 Click="Fps_Click" Tag="30" />
                                    <RadioButton GroupName="fps" Content="60" Style="{StaticResource ChipRadio}"
                                                 IsChecked="{Binding Fps, Converter={StaticResource StringEquals}, ConverterParameter=60, Mode=OneWay}"
                                                 Click="Fps_Click" Tag="60" />
                                </StackPanel>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="ASPECT" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <RadioButton GroupName="ras" Margin="0,0,4,0" Content="9:16" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderAspectCommand}" CommandParameter="9:16"
                                                 IsChecked="{Binding RenderAspect, Converter={StaticResource StringEquals}, ConverterParameter=9:16, Mode=OneWay}" />
                                    <RadioButton GroupName="ras" Margin="0,0,4,0" Content="1:1" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderAspectCommand}" CommandParameter="1:1"
                                                 IsChecked="{Binding RenderAspect, Converter={StaticResource StringEquals}, ConverterParameter=1:1, Mode=OneWay}" />
                                    <RadioButton GroupName="ras" Margin="0,0,4,0" Content="16:9" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderAspectCommand}" CommandParameter="16:9"
                                                 IsChecked="{Binding RenderAspect, Converter={StaticResource StringEquals}, ConverterParameter=16:9, Mode=OneWay}" />
                                    <RadioButton GroupName="ras" Content="21:9" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderAspectCommand}" CommandParameter="21:9"
                                                 IsChecked="{Binding RenderAspect, Converter={StaticResource StringEquals}, ConverterParameter=21:9, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="QUALITY" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <RadioButton GroupName="rq" Margin="0,0,4,0" Content="Draft · 720p" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderQualityCommand}" CommandParameter="draft"
                                                 ToolTip="Fast: crf 24 · ultrafast preset · big files · use for review"
                                                 IsChecked="{Binding RenderQuality, Converter={StaticResource StringEquals}, ConverterParameter=draft, Mode=OneWay}" />
                                    <RadioButton GroupName="rq" Margin="0,0,4,0" Content="Full · 1080p" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderQualityCommand}" CommandParameter="full"
                                                 ToolTip="Balanced: crf 20 · fast preset · sensible default"
                                                 IsChecked="{Binding RenderQuality, Converter={StaticResource StringEquals}, ConverterParameter=full, Mode=OneWay}" />
                                    <RadioButton GroupName="rq" Content="Hi · 4K" Style="{StaticResource ChipRadio}"
                                                 Command="{Binding SetRenderQualityCommand}" CommandParameter="hi"
                                                 ToolTip="Archival: crf 18 · slow preset · longest render time"
                                                 IsChecked="{Binding RenderQuality, Converter={StaticResource StringEquals}, ConverterParameter=hi, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Title cards (T33) — text-only overlays via ffmpeg drawtext.  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TextMonoUpper}" Text="TITLE CARDS · TEXT" />
                                    <Button Grid.Column="1" Padding="8,3" Command="{Binding AddTitleCommand}" Content="+ Title" Style="{StaticResource ButtonPill}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource BrushText4}" Text="Layered via ffmpeg drawtext — no PNG required. Brand-locked palette." />

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TitleTimeline}"
                                              Visibility="{Binding HasTitles, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="8,6" Background="{StaticResource BrushSurface02}" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                                                                <Setter Property="Effect" Value="{StaticResource ShadowGoldGlowSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontFamily="{StaticResource FontDisplay}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource BrushText1}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource TextMonoUpper}" FontSize="9" Foreground="{StaticResource BrushText4}" Text="{Binding Summary}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Width="22" Height="22" Padding="0"
                                                            Command="{Binding DataContext.RemoveTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ButtonIcon}">
                                                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushCrimson}" Text="×" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Inspector for the selected title  -->
                                <StackPanel Visibility="{Binding HasSelectedTitle, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="TEXT" />
                                    <Border Margin="0,4,0,0" Padding="8,5" Background="{StaticResource BrushSurface03}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="4">
                                        <TextBox Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource BrushGoldHi}" FontFamily="{StaticResource FontDisplay}" FontStyle="Italic" FontSize="14" Foreground="{StaticResource BrushText1}" AcceptsReturn="True" TextWrapping="Wrap" MaxLines="3" Text="{Binding SelectedTitle.Text, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="START · DURATION" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="120" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding SelectedTitle.StartSec, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedTitle.StartSec, StringFormat={}{0:F1}s}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.5" Maximum="15" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding SelectedTitle.DurationSec, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedTitle.DurationSec, StringFormat={}{0:F1}s}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="FONT SIZE" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="24" Maximum="200" SmallChange="2" LargeChange="20" Style="{StaticResource GoldSlider}" Value="{Binding SelectedTitle.FontSize, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedTitle.FontSize, StringFormat={}{0}px}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="COLOUR" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <RadioButton GroupName="tcol" Margin="0,0,4,0" Content="Gold" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitleColorCommand}" CommandParameter="0xD4A76A"
                                                     IsChecked="{Binding SelectedTitle.Color, Converter={StaticResource StringEquals}, ConverterParameter=0xD4A76A, Mode=OneWay}" />
                                        <RadioButton GroupName="tcol" Margin="0,0,4,0" Content="Crimson" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitleColorCommand}" CommandParameter="0xB03346"
                                                     IsChecked="{Binding SelectedTitle.Color, Converter={StaticResource StringEquals}, ConverterParameter=0xB03346, Mode=OneWay}" />
                                        <RadioButton GroupName="tcol" Margin="0,0,4,0" Content="Mauve" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitleColorCommand}" CommandParameter="0xB8A5D0"
                                                     IsChecked="{Binding SelectedTitle.Color, Converter={StaticResource StringEquals}, ConverterParameter=0xB8A5D0, Mode=OneWay}" />
                                        <RadioButton GroupName="tcol" Content="White" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitleColorCommand}" CommandParameter="0xFFFFFF"
                                                     IsChecked="{Binding SelectedTitle.Color, Converter={StaticResource StringEquals}, ConverterParameter=0xFFFFFF, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="POSITION" />
                                    <UniformGrid Margin="0,4,0,0" Columns="3" Rows="2">
                                        <RadioButton GroupName="tpos" Margin="0,0,2,2" Content="↖ TL" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitlePositionCommand}" CommandParameter="TL"
                                                     IsChecked="{Binding SelectedTitle.Position, Converter={StaticResource StringEquals}, ConverterParameter=TL, Mode=OneWay}" />
                                        <RadioButton GroupName="tpos" Margin="0,0,2,2" Content="● C" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitlePositionCommand}" CommandParameter="C"
                                                     IsChecked="{Binding SelectedTitle.Position, Converter={StaticResource StringEquals}, ConverterParameter=C, Mode=OneWay}" />
                                        <RadioButton GroupName="tpos" Margin="0,0,0,2" Content="↗ TR" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitlePositionCommand}" CommandParameter="TR"
                                                     IsChecked="{Binding SelectedTitle.Position, Converter={StaticResource StringEquals}, ConverterParameter=TR, Mode=OneWay}" />
                                        <RadioButton GroupName="tpos" Margin="0,0,2,0" Content="↙ BL" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitlePositionCommand}" CommandParameter="BL"
                                                     IsChecked="{Binding SelectedTitle.Position, Converter={StaticResource StringEquals}, ConverterParameter=BL, Mode=OneWay}" />
                                        <Border />
                                        <RadioButton GroupName="tpos" Content="↘ BR" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedTitlePositionCommand}" CommandParameter="BR"
                                                     IsChecked="{Binding SelectedTitle.Position, Converter={StaticResource StringEquals}, ConverterParameter=BR, Mode=OneWay}" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Overlay track (multi-slot, T22)  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextMonoUpper}" Text="OVERLAY TRACK · PIP" />
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource BrushText4}" Text="Drop library clips here · each one becomes a layered PiP at its own start time" />

                                <!--  Drag-drop target — adds a new overlay slot each drop  -->
                                <Border Margin="0,6,0,0" MinHeight="48" Background="{StaticResource BrushSurface03}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="6"
                                        AllowDrop="True" Drop="Overlay_Drop" DragEnter="Overlay_DragEnter" DragLeave="Overlay_DragLeave">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushText3}" Text="DROP A LIBRARY CLIP TO ADD" />
                                    </Grid>
                                </Border>

                                <!--  Overlay strip — list of slots laid out horizontally  -->
                                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding OverlayTimeline}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,0" Width="84" Background="{StaticResource BrushSurface02}" BorderThickness="1" CornerRadius="5" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                                                                    <Setter Property="Effect" Value="{StaticResource ShadowGoldGlowSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Border Height="48" CornerRadius="4,4,0,0" ClipToBounds="True">
                                                            <Image Source="{Binding FilePath, Converter={StaticResource ClipPathToImage}}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" Padding="4,2" Background="{StaticResource BrushBlackOverlay65}" CornerRadius="0,0,4,4">
                                                            <TextBlock Style="{StaticResource TextMonoGold}" FontSize="9" Text="{Binding StartSec, StringFormat={}@{0:F1}s}" />
                                                        </Border>
                                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" Height="18" Padding="0" Margin="2"
                                                                Command="{Binding DataContext.RemoveOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ButtonIcon}">
                                                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushCrimson}" Text="×" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!--  Inspector for the selected overlay  -->
                                <StackPanel Visibility="{Binding HasSelectedOverlay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="SELECTED · START · DURATION" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="120" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding SelectedOverlay.StartSec, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedOverlay.StartSec, StringFormat={}{0:F1}s}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.5" Maximum="20" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding SelectedOverlay.DurationSec, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedOverlay.DurationSec, StringFormat={}{0:F1}s}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="SIZE" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0.1" Maximum="0.6" SmallChange="0.05" LargeChange="0.15" Style="{StaticResource GoldSlider}" Value="{Binding SelectedOverlay.Scale, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedOverlay.Scale, StringFormat={}{0:P0}}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="POSITION" />
                                    <UniformGrid Margin="0,4,0,0" Columns="3" Rows="2">
                                        <RadioButton GroupName="ovpos" Margin="0,0,2,2" Content="↖ TL" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedOverlayPositionCommand}" CommandParameter="TL"
                                                     IsChecked="{Binding SelectedOverlay.Position, Converter={StaticResource StringEquals}, ConverterParameter=TL, Mode=OneWay}" />
                                        <RadioButton GroupName="ovpos" Margin="0,0,2,2" Content="● C" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedOverlayPositionCommand}" CommandParameter="C"
                                                     IsChecked="{Binding SelectedOverlay.Position, Converter={StaticResource StringEquals}, ConverterParameter=C, Mode=OneWay}" />
                                        <RadioButton GroupName="ovpos" Margin="0,0,0,2" Content="↗ TR" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedOverlayPositionCommand}" CommandParameter="TR"
                                                     IsChecked="{Binding SelectedOverlay.Position, Converter={StaticResource StringEquals}, ConverterParameter=TR, Mode=OneWay}" />
                                        <RadioButton GroupName="ovpos" Margin="0,0,2,0" Content="↙ BL" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedOverlayPositionCommand}" CommandParameter="BL"
                                                     IsChecked="{Binding SelectedOverlay.Position, Converter={StaticResource StringEquals}, ConverterParameter=BL, Mode=OneWay}" />
                                        <Border />
                                        <RadioButton GroupName="ovpos" Content="↘ BR" Style="{StaticResource ChipRadio}"
                                                     Command="{Binding SetSelectedOverlayPositionCommand}" CommandParameter="BR"
                                                     IsChecked="{Binding SelectedOverlay.Position, Converter={StaticResource StringEquals}, ConverterParameter=BR, Mode=OneWay}" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Multi-audio mixer (T34). Active when AudioTracks has 1+ rows;
                              the legacy single-track fields below stay as a back-compat fallback.  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TextMonoUpper}" Text="AUDIO MIXER · MULTI-TRACK" />
                                    <Button Grid.Column="1" Padding="8,3" Command="{Binding AddAudioTrackCommand}" Content="+ Track" Style="{StaticResource ButtonPill}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="{StaticResource BrushText4}" Text="Each track plays from its own start time, mixed via amix." />

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AudioTracks}"
                                              Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" Padding="8,6" Background="{StaticResource BrushSurface02}" BorderThickness="1" CornerRadius="6" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11" Foreground="{StaticResource BrushText1}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource TextMonoUpper}" FontSize="9" Foreground="{StaticResource BrushText4}" Text="{Binding Summary}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Width="22" Height="22" Padding="0"
                                                            Command="{Binding DataContext.RemoveAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ButtonIcon}">
                                                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushCrimson}" Text="×" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Inspector for the selected audio track  -->
                                <StackPanel Visibility="{Binding HasSelectedAudio, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="START · VOLUME" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="120" SmallChange="0.5" LargeChange="2" Style="{StaticResource GoldSlider}" Value="{Binding SelectedAudio.StartSec, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedAudio.StartSec, StringFormat={}{0:F1}s}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" Style="{StaticResource GoldSlider}" Value="{Binding SelectedAudio.Volume, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedAudio.Volume, StringFormat={}{0:F2}×}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="FADE IN · FADE OUT" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="0.5" Style="{StaticResource GoldSlider}" Value="{Binding SelectedAudio.FadeInSec, Mode=TwoWay}"
                                                ToolTip="Linear fade-up at the start of this track" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedAudio.FadeInSec, StringFormat={}↗ {0:F1}s}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="0" Maximum="10" SmallChange="0.1" LargeChange="0.5" Style="{StaticResource GoldSlider}" Value="{Binding SelectedAudio.FadeOutSec, Mode=TwoWay}"
                                                ToolTip="Linear fade-down at the end of this track" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding SelectedAudio.FadeOutSec, StringFormat={}↘ {0:F1}s}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Audio track (legacy single-track fallback — used when AudioTracks is empty)  -->
                        <Border Margin="0,12,0,0" Padding="14,10" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextMonoUpper}" Text="AUDIO · OPTIONAL" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="8,5" Background="{StaticResource BrushSurface03}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="4">
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource BrushText2}" Text="{Binding AudioFileName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,5" Command="{Binding BrowseAudioCommand}" Content="Browse" Style="{StaticResource ButtonPill}" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,5" Command="{Binding ClearAudioCommand}" Style="{StaticResource ButtonPill}">
                                        <Path Width="9" Height="9" Data="{StaticResource IcoClose}" Stretch="Uniform" Stroke="{StaticResource BrushText3}" StrokeThickness="1.4" />
                                    </Button>
                                </Grid>

                                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding AudioTakes}" SelectionChanged="AudioTake_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11.5" Foreground="{StaticResource BrushText1}" Text="{Binding FileName}" />
                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource TextMonoUpper}" FontSize="9" Text="{Binding ProviderDisplayName}" />
                                                    <TextBlock Margin="6,0" FontSize="9" Foreground="{StaticResource BrushText4}" Text="·" />
                                                    <TextBlock Style="{StaticResource TextMonoUpper}" FontSize="9" Text="{Binding VoiceDisplayName}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMonoUpper}" Text="VOLUME" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.5" Style="{StaticResource GoldSlider}" Value="{Binding AudioVolume, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding AudioVolume, StringFormat={}{0:F2}×}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Render bar (bottom)  -->
        <Border Grid.Row="2" Padding="22,14" Background="{StaticResource BrushSurface02}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText3}">
                        <Run Text="{Binding Timeline.Count, Mode=OneWay}" /><Run Text=" SLOTS · " />
                        <Run Foreground="{StaticResource BrushGoldHi}" Text="{Binding TotalDurationLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Padding="26,8" Command="{Binding RenderCommand}" Content="✦  Render film" Style="{StaticResource ButtonPillGold}"
                        IsEnabled="{Binding IsRendering, Converter={StaticResource InvBoolToVis}, FallbackValue=True}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
