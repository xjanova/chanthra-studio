<Window
    x:Class="ChanthraStudio.Views.WebStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ChanthraStudio.Views"
    Title="Web Studio — Chanthra Studio"
    Width="1320"
    Height="880"
    MinWidth="900"
    MinHeight="600"
    Background="#FF15100E"
    FontFamily="{StaticResource FontUI}"
    Foreground="{StaticResource BrushText1}"
    WindowStartupLocation="CenterScreen">
    <!--
        A normal (non-transparent) window. The main window uses
        AllowsTransparency=True for its mica chrome, and the HWND-based WebView2
        control cannot composite into a layered window (airspace) — it loads the
        page but paints nothing. Hosting WebView2 in its own opaque window is the
        same fix the BrainX dashboard shipped for its visible WebView2 login window.
    -->
    <views:WebStudioView />
</Window>
