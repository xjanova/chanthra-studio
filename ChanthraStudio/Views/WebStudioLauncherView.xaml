<UserControl
    x:Class="ChanthraStudio.Views.WebStudioLauncherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="900">
    <Grid>
        <Border
            MaxWidth="520"
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource BrushBgMica}"
            BorderBrush="{StaticResource BrushLineHairline}"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel>
                <Path
                    Width="40"
                    Height="40"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Center"
                    Data="{StaticResource IcoGlobe}"
                    Stretch="Uniform"
                    Stroke="{StaticResource BrushGold}"
                    StrokeThickness="1.4" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FontDisplay}"
                    FontSize="20"
                    Foreground="{StaticResource BrushText1}"
                    Text="Web Studio" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource BrushText1}"
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="เปิดในหน้าต่างแยก — หน้าต่างหลักโปร่งใส (mica) ทำให้ฝังเบราว์เซอร์ WebView2 ตรงนี้ไม่ได้ · ล็อกอินเว็บครั้งเดียว แล้วสอน/รัน recipe ในหน้าต่างนั้น" />
                <Button
                    Margin="0,20,0,0"
                    Padding="18,9"
                    HorizontalAlignment="Center"
                    Click="Open_Click"
                    Content="เปิด / โฟกัสหน้าต่าง Web Studio" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
