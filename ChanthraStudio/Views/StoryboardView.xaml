<UserControl
    x:Class="ChanthraStudio.Views.StoryboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ChanthraStudio.ViewModels"
    Background="{StaticResource BrushBgBase}"
    d:DataContext="{d:DesignInstance vm:StoryboardViewModel}"
    d:DesignHeight="934"
    d:DesignWidth="1576"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Single / multiline input field  -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushText1}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushGoldHi}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="bd"
                            Background="{StaticResource BrushBgInset}"
                            BorderBrush="{StaticResource BrushLineHairline}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushLineGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Data-driven single-select chip (aspect)  -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CommandParameter" Value="{Binding Id}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="13,7"
                            Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushLineHairline}"
                            BorderThickness="1"
                            CornerRadius="99">
                            <TextBlock FontFamily="{StaticResource FontUI}" FontSize="12" Foreground="{StaticResource BrushText2}" Text="{Binding Label}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushLineGold}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FD4A76A" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Card chip (tarot card)  -->
        <Style x:Key="CardChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="{StaticResource BrushBgInset}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushLineGold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="99" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="384" />
        </Grid.ColumnDefinitions>

        <!--  ============== LEFT — template + concept form ==============  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource BrushBgBase}"
            BorderBrush="{StaticResource BrushLineHairline}"
            BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource TextPanelHeader}">
                        <Run Foreground="{StaticResource BrushGold}" Text="✦ " />
                        <Run Text="Storyboard" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource TextMonoUpper}"
                        Foreground="{StaticResource BrushGoldHi}"
                        Text="เทมเพลต → สตอรี่บอร์ด → คลิป" />
                    <Border Margin="0,14,0,12" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="0,1,0,0" />
                </StackPanel>

                <!--  Generate pinned to the bottom  -->
                <Button
                    DockPanel.Dock="Bottom"
                    Margin="0,12,0,0"
                    HorizontalContentAlignment="Center"
                    Command="{Binding GenerateCommand}"
                    Style="{StaticResource ButtonSummonCta}"
                    ToolTip="ให้ AI ขยายคอนเซ็ปต์เป็นสตอรี่บอร์ดหลายคลิป">
                    <TextBlock Style="{StaticResource TextSummonCta}" Text="✦ Generate storyboard" />
                </Button>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Style="{StaticResource TextSectionDivider}" Text="TEMPLATE" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,0,6"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SelectTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Padding="12,10" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="9">
                                                    <StackPanel>
                                                        <TextBlock FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource BrushText1}" Text="{Binding Name}" />
                                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Text="{Binding Blurb}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushLineGold}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1FD4A76A" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushGoldHi}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource TextSectionDivider}" Text="CONCEPT / HOOK" />
                        <TextBox Margin="0,8,0,0" MinHeight="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource FieldBox}" Text="{Binding Concept, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource TextSectionDivider}" Text="CHARACTER · LOCKED" />
                        <TextBox Margin="0,8,0,0" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource FieldBox}" Text="{Binding Character, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource TextSectionDivider}" Text="STYLE" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource FieldBox}" Text="{Binding StyleNote, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource TextSectionDivider}" Text="VOICE" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource FieldBox}" Text="{Binding VoiceNote, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource TextSectionDivider}" Text="REFERENCE IMAGE · @ref1" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="9,7" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="6">
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushText3}" TextTrimming="CharacterEllipsis" Text="{Binding ReferenceImageLabel}" />
                            </Border>
                            <Button Grid.Column="1" Width="30" Height="30" Margin="6,0,0,0" Command="{Binding BrowseReferenceCommand}" Style="{StaticResource ButtonIcon}" ToolTip="Browse">
                                <Path Width="13" Height="13" Data="{StaticResource IcoPaperclip}" Stretch="Uniform" Stroke="{StaticResource BrushText3}" StrokeThickness="1.4" />
                            </Button>
                            <Button Grid.Column="2" Width="30" Height="30" Margin="4,0,0,0" Command="{Binding ClearReferenceCommand}" Style="{StaticResource ButtonIcon}" ToolTip="Clear"
                                    Visibility="{Binding HasReferenceImage, Converter={StaticResource BoolToVis}}">
                                <Path Width="12" Height="12" Data="{StaticResource IcoTrash}" Stretch="Uniform" Stroke="{StaticResource BrushCrimson}" StrokeThickness="1.4" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource TextLabel}" Text="Clips" />
                            <Slider Grid.Column="1" Margin="10,0" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource GoldSlider}" Value="{Binding ClipCount}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding ClipCount}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource TextLabel}" Text="Each" />
                            <Slider Grid.Column="1" Margin="10,0" Minimum="4" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource GoldSlider}" Value="{Binding ClipDurationSec}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TextMonoGold}" Text="{Binding ClipDurationLabel}" />
                        </Grid>

                        <TextBlock Margin="0,16,0,8" Style="{StaticResource TextSectionDivider}" Text="ASPECT" />
                        <ItemsControl ItemsSource="{Binding AspectOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipBtn}" Command="{Binding DataContext.SetAspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,12,0,8" Style="{StaticResource TextSectionDivider}" Text="DEFAULT ENGINE" />
                        <Border Padding="11,3" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <ComboBox
                                Height="30"
                                ItemsSource="{Binding Routes}"
                                SelectedItem="{Binding DefaultRoute, Mode=TwoWay}"
                                DisplayMemberPath="DisplayName"
                                Style="{StaticResource LunarComboBox}"
                                ToolTip="เครื่องสร้างคลิปเริ่มต้น (เปลี่ยนรายคลิปได้ในการ์ด)" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  ============== CENTER — clips ==============  -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <StackPanel Margin="26,20,26,8" DockPanel.Dock="Top">
                <TextBlock FontFamily="{StaticResource FontDisplay}" FontSize="22" FontStyle="Italic" Foreground="{StaticResource BrushText1}" Text="{Binding BoardTitle}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource TextSecondary}" FontSize="12.5" Text="แต่ละคลิป: ก๊อปปี้พร้อมต์ · export ComfyUI · หรือส่งเข้า Queue ตามเครื่องที่เลือก" />
            </StackPanel>

            <ScrollViewer Margin="26,4,18,18" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!--  Empty state  -->
                    <Border Padding="22" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="12"
                            VerticalAlignment="Top"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushGoldHi}" Text="✦ ยังไม่มีสตอรี่บอร์ด" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="เลือกเทมเพลตทางซ้าย (เทมเพลตแรก 'เลิกจน' มีตัวอย่างพร้อมใช้) หรือพิมพ์คอนเซ็ปต์เองแล้วกด ✦ Generate storyboard" />
                        </StackPanel>
                    </Border>

                    <!--  Clip cards  -->
                    <ItemsControl ItemsSource="{Binding Clips}" Visibility="{Binding HasSpec, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <StackPanel>
                                        <!--  Header: clip label + status + engine  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource FontUI}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource BrushText1}" Text="{Binding Header}" TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="1" x:Name="statusPill" Margin="8,0" Padding="8,3" VerticalAlignment="Center" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="99">
                                                <TextBlock x:Name="statusText" Style="{StaticResource TextMono}" FontSize="10" Foreground="{StaticResource BrushText3}" Text="{Binding StatusLabel}" />
                                            </Border>

                                            <Border Grid.Column="2" Padding="9,2" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                                                <ComboBox
                                                    Height="26"
                                                    ItemsSource="{Binding DataContext.Routes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedValue="{Binding Route, Mode=TwoWay}"
                                                    SelectedValuePath="Id"
                                                    DisplayMemberPath="DisplayName"
                                                    Style="{StaticResource LunarComboBox}"
                                                    ToolTip="เครื่องสร้างคลิปนี้" />
                                            </Border>
                                        </Grid>

                                        <!--  Visual  -->
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Visual}" />

                                        <!--  Camera + SFX  -->
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText4}" Visibility="{Binding Camera, Converter={StaticResource NotNullOrEmpty}, FallbackValue=Collapsed}">
                                                <Run Text="CAMERA — " /><Run Foreground="{StaticResource BrushText3}" Text="{Binding Camera, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText4}" Visibility="{Binding Sfx, Converter={StaticResource NotNullOrEmpty}, FallbackValue=Collapsed}">
                                                <Run Text="SFX — " /><Run Foreground="{StaticResource BrushText3}" Text="{Binding Sfx, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!--  Dialogue  -->
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Dialogue}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="0,0,7,0" Foreground="{StaticResource BrushGold}" Text="“" FontFamily="{StaticResource FontDisplay}" FontSize="15" />
                                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource FontUI}" FontSize="13" Foreground="{StaticResource BrushText1}" TextWrapping="Wrap" Text="{Binding Text}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  Cards  -->
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardChip}">
                                                        <TextBlock Style="{StaticResource TextMono}" FontSize="10.5" Foreground="{StaticResource BrushGoldHi}" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  Audio behavior  -->
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource TextMonoUpper}" Foreground="{StaticResource BrushText4}" TextWrapping="Wrap" Visibility="{Binding AudioBehavior, Converter={StaticResource NotNullOrEmpty}, FallbackValue=Collapsed}">
                                            <Run Text="AUDIO — " /><Run Foreground="{StaticResource BrushText3}" Text="{Binding AudioBehavior, Mode=OneWay}" />
                                        </TextBlock>

                                        <!--  Progress  -->
                                        <ProgressBar Margin="0,12,0,0" Height="3" Minimum="0" Maximum="100" Background="{StaticResource BrushBgInset}" Foreground="{StaticResource BrushGold}" BorderThickness="0"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                                        <!--  Footer actions  -->
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button Margin="0,0,8,0" Padding="11,7" Command="{Binding DataContext.CopyClipPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonPill}" ToolTip="ก๊อปปี้พร้อมต์คลิปนี้">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource IcoCopy}" Stretch="Uniform" Stroke="{StaticResource BrushText2}" StrokeThickness="1.4" />
                                                    <TextBlock Text="Copy prompt" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,8,0" Padding="11,7" Command="{Binding DataContext.ExportClipComfyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonPill}" ToolTip="บันทึก ComfyUI scene workflow">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource IcoFilm}" Stretch="Uniform" Stroke="{StaticResource BrushText2}" StrokeThickness="1.4" />
                                                    <TextBlock Text="ComfyUI" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,8,0" Padding="13,7" Command="{Binding DataContext.SendClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonSummonCta}" ToolTip="ส่งคลิปนี้เข้า Queue สร้างจริง">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource IcoSend}" Stretch="Uniform" Fill="#FF1A0D05" />
                                                    <TextBlock Style="{StaticResource TextSummonCta}" Text="Queue" />
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="11,7" Command="{Binding DataContext.PlayClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonPill}" ToolTip="เปิดไฟล์ที่สร้างเสร็จ"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Margin="0,0,6,0" Data="{StaticResource IcoPlay}" Stretch="Uniform" Fill="{StaticResource BrushGoldHi}" />
                                                    <TextBlock Text="Play" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  card border colour by ShotStatus  -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="0,0,0,12" />
                                            <Setter Property="Padding" Value="16" />
                                            <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushLineHairline}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Generating">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushLineGold}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushLineCrimson}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!--  ============== RIGHT — Facebook post + board actions ==============  -->
        <Border
            Grid.Column="2"
            Background="{StaticResource BrushBgBase}"
            BorderBrush="{StaticResource BrushLineHairline}"
            BorderThickness="1,0,0,0">
            <DockPanel Margin="18,18,18,18" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextPanelHeader}">
                    <Run Foreground="{StaticResource BrushGold}" Text="✦ " /><Run Text="Facebook post" />
                </TextBlock>

                <!--  Footer: status + board actions  -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Margin="2,0,2,8" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushGoldHi}"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotNullOrEmpty}, FallbackValue=Collapsed}" />
                    <StackPanel Visibility="{Binding HasSpec, Converter={StaticResource BoolToVis}}">
                        <Button Margin="0,0,0,8" HorizontalContentAlignment="Center" Command="{Binding SendAllCommand}" Style="{StaticResource ButtonSummonCta}" ToolTip="ส่งทุกคลิปเข้า Queue">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource TextSummonCta}" Text="→ Send all clips to Queue" />
                        </Button>
                        <UniformGrid Columns="2">
                            <Button Margin="0,0,4,0" Padding="11,8" HorizontalContentAlignment="Center" Command="{Binding CopyBoardCommand}" Style="{StaticResource ButtonPill}">
                                <TextBlock Text="⧉ Copy board" />
                            </Button>
                            <Button Margin="4,0,0,0" Padding="11,8" HorizontalContentAlignment="Center" Command="{Binding CopyFacebookCommand}" Style="{StaticResource ButtonPill}">
                                <TextBlock Text="⧉ Copy post" />
                            </Button>
                        </UniformGrid>
                        <Button Margin="0,8,0,0" Padding="11,8" HorizontalContentAlignment="Center" Command="{Binding ExportAllComfyCommand}" Style="{StaticResource ButtonPill}" ToolTip="บันทึก scene workflow ของทุกคลิป">
                            <TextBlock Text="⬇ Export all ComfyUI workflows" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Body: caption + tags (empty hint until a board exists)  -->
                <Grid Margin="0,14,0,12">
                    <Border Padding="16" VerticalAlignment="Top" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="10"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Text="คำโพสต์ Facebook + แฮชแท็ก จะปรากฏที่นี่หลังสร้างสตอรี่บอร์ด" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSpec, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushLineGold}" BorderThickness="1" CornerRadius="10">
                            <TextBox
                                Padding="14"
                                MinHeight="220"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{StaticResource FontUI}"
                                FontSize="12.5"
                                Foreground="{StaticResource BrushText1}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                Text="{Binding Facebook.Caption, Mode=OneWay}" />
                        </Border>

                        <TextBlock Margin="2,14,0,6" Style="{StaticResource TextSectionDivider}" Text="HASHTAGS" />
                        <Border Padding="12" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <TextBlock FontFamily="{StaticResource FontUI}" FontSize="12" Foreground="{StaticResource BrushGoldHi}" TextWrapping="Wrap" Text="{Binding Facebook.HashtagLine, Mode=OneWay}" />
                        </Border>

                        <TextBlock Margin="2,12,0,6" Style="{StaticResource TextSectionDivider}" Text="แท็กแบบคอมม่า" />
                        <Border Padding="12" Background="{StaticResource BrushBgInset}" BorderBrush="{StaticResource BrushLineHairline}" BorderThickness="1" CornerRadius="8">
                            <TextBlock FontFamily="{StaticResource FontUI}" FontSize="12" Foreground="{StaticResource BrushText2}" TextWrapping="Wrap" Text="{Binding Facebook.CommaTagLine, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
